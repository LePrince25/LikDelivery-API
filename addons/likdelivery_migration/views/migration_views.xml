<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="likdelivery_migration_import_form" model="ir.ui.view">
        <field name="name">likdelivery.migration.import.form</field>
        <field name="model">likdelivery.migration.import</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_run_import" type="object"
                            string="Lancer l'import" class="oe_highlight"
                            invisible="state == 'running'"/>
                    <button name="action_validate" type="object"
                            string="Recalculer le rapport"
                            invisible="state == 'running'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,running,done,failed"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sqlite_path"/>
                    </group>
                    <group string="Rapport de réconciliation">
                        <field name="report" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="likdelivery_migration_import_list" model="ir.ui.view">
        <field name="name">likdelivery.migration.import.list</field>
        <field name="model">likdelivery.migration.import</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="sqlite_path"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_likdelivery_migration_import" model="ir.actions.act_window">
        <field name="name">Imports de migration</field>
        <field name="res_model">likdelivery.migration.import</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="likdelivery_migration_map_list" model="ir.ui.view">
        <field name="name">likdelivery.migration.map.list</field>
        <field name="model">likdelivery.migration.map</field>
        <field name="arch" type="xml">
            <list>
                <field name="entity"/>
                <field name="old_id"/>
                <field name="new_id"/>
            </list>
        </field>
    </record>

    <record id="action_likdelivery_migration_map" model="ir.actions.act_window">
        <field name="name">Correspondances IDs</field>
        <field name="res_model">likdelivery.migration.map</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_likdelivery_migration"
              name="Migration"
              parent="likdelivery_core.menu_likdelivery_root"
              sequence="100"
              groups="likdelivery_core.group_lik_admin"/>
    <menuitem id="menu_likdelivery_migration_import"
              name="Imports"
              parent="menu_likdelivery_migration"
              action="action_likdelivery_migration_import"
              sequence="10"/>
    <menuitem id="menu_likdelivery_migration_map"
              name="Correspondances IDs"
              parent="menu_likdelivery_migration"
              action="action_likdelivery_migration_map"
              sequence="20"/>
</odoo>
