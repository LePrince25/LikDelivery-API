<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Record rules LikDelivery

        Semantique Odoo verifiee (odoo/addons/base/models/ir_rule.py,
        _compute_domain) :
          * les rules d'un meme utilisateur sont OR-ees entre elles ;
          * une rule sans groupe est AND-ee a tout le monde (donc jamais
            utilisee ici, elle aurait verrouille les admins) ;
          * un utilisateur qui ne matche AUCUNE rule du modele n'est pas
            filtre.

        Consequence : les rules restrictives sont liees aux 4 roles metiers
        (client, fournisseur, livreur, societe). Le role Administrateur et les
        comptes de supervision ne sont lies a aucune rule restrictive, ou
        benefitent de la rule "global" OR-ee, donc ils conservent l'acces
        complet. L'API /api/v1/* tourne en sudo() : elle n'est pas impactee.

        Les domaines portent sur des Many2one "res.partner" et utilisent donc
        user.partner_id.id. Une societe est tiers transporteur : les commandes
        qu'elle livre ne lui appartiennent pas (client_id/supplier_id), d'ou la
        clause run_ids.livreur_id.lik_employer_societe_id qui aligne l'acces a
        la commande sur celui deja accorde a sa course.
    -->

    <!-- ===== Commandes ===== -->
    <record id="rule_lik_order_own" model="ir.rule">
        <field name="name">Mes commandes</field>
        <field name="model_id" ref="model_likdelivery_order"/>
        <field name="domain_force">[
            '|', '|', '|', '|',
            ('client_id', '=', user.partner_id.id),
            ('supplier_id', '=', user.partner_id.id),
            ('run_ids.livreur_id', '=', user.partner_id.id),
            ('preferred_societe_id', '=', user.partner_id.id),
            ('run_ids.livreur_id.lik_employer_societe_id', '=', user.partner_id.id),
        ]</field>
        <field name="groups" eval="[
            Command.link(ref('likdelivery_core.group_lik_client')),
            Command.link(ref('likdelivery_core.group_lik_fournisseur')),
            Command.link(ref('likdelivery_core.group_lik_livreur')),
            Command.link(ref('likdelivery_core.group_lik_societe')),
        ]"/>
    </record>

    <record id="rule_lik_order_global" model="ir.rule">
        <field name="name">Commandes : acces global</field>
        <field name="model_id" ref="model_likdelivery_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('likdelivery_core.group_lik_perm_backend_global'))]"/>
    </record>

